# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ComicVine API key. Get one (free) at https://comicvine.gamespot.com/api/.
COMICVINE_API_KEY=replace_with_your_key

# Metron credentials (for forward calendar — Item A v2). Get an account at
# https://metron.cloud/. Leave empty to disable the Metron path; the
# `metron_enabled` settings row in the DB is the actual feature gate, so
# both must be in place: credentials here AND the row flipped to 'true'.
METRON_API_USER=
METRON_API_PASSWORD=

# Absolute path to your comic library on the host. This will be bind-mounted
# into the container at /library:ro. On macOS with an SMB-mounted library
# this is often something like /Volumes/comics. The path must be in Docker
# Desktop's File Sharing allow-list, or the bind mount fails silently and
# the container starts but reports an empty library on every scan.
LIBRARY_PATH=/path/to/your/library

# Optional. Defaults shown.
# LOG_LEVEL=info
# MATCH_THRESHOLD=0.85

# Phase B post-process pipeline (optional). Set both to enable:
# - DOWNLOAD_WATCH_HOST: absolute host path that holds completed
#   downloads (e.g. SAB's complete-folder). Bind-mounted into the
#   container.
# - DOWNLOAD_WATCH_PATH: in-container path the watcher reads from.
#   Must match the right-hand side of the DOWNLOAD_WATCH_HOST bind in
#   docker-compose.yml. Default mount target is /watch.
# When DOWNLOAD_WATCH_PATH is unset, Phase B is disabled and the
# container boots without the watcher.
# DOWNLOAD_WATCH_HOST=/Volumes/downloads
# DOWNLOAD_WATCH_PATH=/watch
